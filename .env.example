# Vercel > Settings > Environment Variables 에 그대로 등록하세요.
# 이 값들은 서버에서만 쓰이며 브라우저로 나가지 않습니다.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...        # Supabase > Settings > API > service_role
TOSS_SECRET_KEY=test_sk_...                  # 계약 전에는 테스트 키, 심사 후 라이브 키로 교체
ADMIN_KEY=아무도_모르는_긴_문자열              # 환불 API 호출용

# 클라이언트 키는 공개되어도 되는 값이며 HTML 안에 넣습니다.
